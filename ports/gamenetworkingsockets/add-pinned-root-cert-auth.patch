+bool BParsePinnedRootCertPublicKey( const std::string &sBase64, std::string &outRawKey, SteamNetworkingErrMsg &errMsg )
+{
+	outRawKey.clear();
+	if ( sBase64.empty() )
+	{
+		V_strcpy_safe( errMsg, "Pinned root cert public key is empty" );
+		return false;
+	}
+
+	std_vector<uint8> buf;
+	uint32 cbDecoded = CCrypto::Base64DecodeMaxOutput( sBase64.length() );
+	buf.resize( cbDecoded );
+	if ( !CCrypto::Base64Decode( sBase64.c_str(), sBase64.length(), buf.data(), &cbDecoded, false ) )
+	{
+		V_strcpy_safe( errMsg, "Pinned root cert public key is not valid base64" );
+		return false;
+	}
+
+	// Let the key object decide what lengths are acceptable, rather than
+	// duplicating a size constant that lives with the crypto backend.
+	CECSigningPublicKey keyPublic;
+	if ( !keyPublic.SetRawDataWithoutWipingInput( buf.data(), cbDecoded ) )
+	{
+		V_sprintf_safe( errMsg, "Pinned root cert public key is not a valid Ed25519 public key (%u bytes)", cbDecoded );
+		return false;
+	}
+
+	outRawKey.assign( (const char *)buf.data(), cbDecoded );
+	return true;
+}
+
+bool BCheckCertAgainstPinnedRoot( const CMsgSteamDatagramCertificateSigned &msgCertSigned, const std::string &sRawRootPublicKey, SteamNetworkingErrMsg &errMsg )
+{
+	// A pinned root is an instruction to require a signature, so an
+	// unsigned cert is a failure here rather than something to fall back on.
+	if ( !msgCertSigned.has_ca_signature() || msgCertSigned.ca_signature().empty() )
+	{
+		V_strcpy_safe( errMsg, "Peer presented a cert with no CA signature, but a root cert is pinned for this connection" );
+		return false;
+	}
+
+	// The pinned key is the whole authority: we deliberately do not consult
+	// the process-wide cert store, so no other trusted key can vouch for
+	// this peer, and ca_key_id is a hint we never have to believe.
+	if ( !BCheckSignature( msgCertSigned.cert(), CMsgSteamDatagramCertificate_EKeyType_ED25519, sRawRootPublicKey, msgCertSigned.ca_signature(), errMsg ) )
+		return false;
+
+	return true;
+}
