 /////////////////////////////////////////////////////////////////////////////
 //
+// Self-signed certificates
+//
+// Two halves of issuing a cert for this interface's own connection key,
+// signed by a key the application owns.  Split so that the private key never
+// crosses this boundary: the caller signs the blob with whatever crypto stack
+// already holds its key, and GNS only does the protobuf assembly that its
+// message definitions are not public enough for the caller to do itself.
+//
+/////////////////////////////////////////////////////////////////////////////
+
+STEAMNETWORKINGSOCKETS_INTERFACE bool SteamNetworkingSockets_GetSelfSignedCertBlobToSign(
+	ISteamNetworkingSockets *pInterface, int nSecondsValid,
+	int *pcbBlob, void *pBlob, SteamNetworkingErrMsg &errMsg )
+{
+	if ( !pInterface || !pcbBlob )
+	{
+		V_strcpy_safe( errMsg, "Bad parameters" );
+		return false;
+	}
+
+	// The interface already builds a cert carrying its own connection public
+	// key and identity for the request path; reuse it rather than duplicating
+	// how that key is generated and cached.
+	int cbRequest = 0;
+	if ( !pInterface->GetCertificateRequest( &cbRequest, nullptr, errMsg ) )
+		return false;
+	std_vector<uint8> bufRequest;
+	bufRequest.resize( cbRequest );
+	if ( !pInterface->GetCertificateRequest( &cbRequest, bufRequest.data(), errMsg ) )
+		return false;
+
+	CMsgSteamDatagramCertificateRequest msgRequest;
+	if ( !msgRequest.ParseFromArray( bufRequest.data(), cbRequest ) )
+	{
+		V_strcpy_safe( errMsg, "CMsgSteamDatagramCertificateRequest failed protobuf parse" );
+		return false;
+	}
+
+	CMsgSteamDatagramCertificate msgCert = msgRequest.cert();
+	if ( msgCert.key_data().empty() )
+	{
+		V_strcpy_safe( errMsg, "Certificate request carried no public key" );
+		return false;
+	}
+
+	// Same cast this file already uses to reach the concrete utils object:
+	// neither GetAppID nor GetTimeSecure is on the public interface.
+	CSteamNetworkingUtils *pUtils = (CSteamNetworkingUtils *)SteamNetworkingUtils();
+
+	// A cert bound to an identity must name an app, or the peer rejects it
+	// before it ever looks at who signed it.  It has to be *our* app ID --
+	// SetCertificate checks the cert it is handed against this interface's own
+	// ID, so any other value comes back as "does not authorize us".
+	msgCert.add_app_ids( pUtils->GetAppID() );
+
+	// The clock the verifying side checks expiry against.
+	time_t timeNow = pUtils->GetTimeSecure();
+	msgCert.set_time_created( (uint32)timeNow );
+	msgCert.set_time_expiry( (uint32)( timeNow + nSecondsValid ) );
+
+	int cb = ProtoMsgByteSize( msgCert );
+	if ( !pBlob )
+	{
+		*pcbBlob = cb;
+		return true;
+	}
+	if ( cb > *pcbBlob )
+	{
+		*pcbBlob = cb;
+		V_sprintf_safe( errMsg, "%d byte buffer not big enough; %d bytes required", *pcbBlob, cb );
+		return false;
+	}
+	*pcbBlob = cb;
+	uint8 *p = (uint8 *)pBlob;
+	DbgVerify( msgCert.SerializeWithCachedSizesToArray( p ) == p + cb );
+	return true;
+}
+
+STEAMNETWORKINGSOCKETS_INTERFACE bool SteamNetworkingSockets_InstallSelfSignedCert(
+	ISteamNetworkingSockets *pInterface,
+	const void *pCertBlob, int cbCertBlob,
+	const void *pSignature, int cbSignature,
+	const void *pRootPublicKey, int cbRootPublicKey,
+	SteamNetworkingErrMsg &errMsg )
+{
+	if ( !pInterface || !pCertBlob || !pSignature || !pRootPublicKey )
+	{
+		V_strcpy_safe( errMsg, "Bad parameters" );
+		return false;
+	}
+	if ( cbSignature != sizeof(CryptoSignature_t) )
+	{
+		V_sprintf_safe( errMsg, "Signature must be %d bytes, got %d", (int)sizeof(CryptoSignature_t), cbSignature );
+		return false;
+	}
+
+	CMsgSteamDatagramCertificateSigned msgSigned;
+	msgSigned.set_cert( pCertBlob, cbCertBlob );
+	msgSigned.set_ca_signature( pSignature, cbSignature );
+	msgSigned.set_ca_key_id( CalculatePublicKeyID_Ed25519( pRootPublicKey, cbRootPublicKey ) );
+
+	std_vector<uint8> buf;
+	buf.resize( ProtoMsgByteSize( msgSigned ) );
+	DbgVerify( msgSigned.SerializeWithCachedSizesToArray( buf.data() ) == buf.data() + buf.size() );
+
+	return pInterface->SetCertificate( buf.data(), (int)buf.size(), errMsg );
+}
